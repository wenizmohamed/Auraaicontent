# Dockerfile.ci — minimal multi-stage server build for CI smoke runs only.
# Production deploy uses /opt/radix-v2 + pm2 directly on the VPS, NOT this image.

# Stage 1: full deps (incl. devDeps) — needed for tsc + @types/* during build.
FROM node:22-alpine AS deps
WORKDIR /app
COPY server/package*.json ./server/
RUN cd server && npm ci

# Stage 2: prod-only deps — what ships in the runtime image.
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY server/package*.json ./server/
RUN cd server && npm ci --omit=dev

# Stage 3: build — uses full deps so TS types resolve.
FROM node:22-alpine AS build
WORKDIR /app
COPY tsconfig.base.json ./
COPY server/ ./server/
COPY --from=deps /app/server/node_modules ./server/node_modules
RUN cd server && npx prisma generate && npm run build

# Stage 4: runtime — strips devDeps but keeps the prisma client artifacts.
FROM node:22-alpine
WORKDIR /app/server
RUN apk add --no-cache openssl
COPY --from=prod-deps /app/server/node_modules ./node_modules
# Re-generate prisma client against the prod node_modules so the engine
# binary lands in the slim image too.
COPY --from=build /app/server/prisma ./prisma
COPY --from=build /app/server/package.json ./
RUN npx prisma generate
COPY --from=build /app/server/dist ./dist
EXPOSE 8080
# db push, not migrate deploy: the migration history can't build an empty DB
# (5 models were never given a creating migration — the first ALTER on
# PlatformConnection fails), and this DB is always fresh and thrown away.
CMD ["sh", "-c", "npx prisma db push --skip-generate && node dist/index.js"]
