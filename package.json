{
  "name": "aura-ai-content-planner",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace @aura/desktop run dev",
    "dev:server": "npm --workspace @aura/server run dev",
    "dev:preview": "npm --workspace @aura/preview-web run dev",
    "dev": "npm run dev:desktop",
    "build:desktop": "npm --workspace @aura/desktop run build",
    "build:server": "npm --workspace @aura/server run build",
    "build": "npm run build:desktop",
    "electron:dev": "npm --workspace @aura/desktop run electron:dev",
    "electron:build": "npm --workspace @aura/desktop run electron:build",
    "prisma:migrate": "npm --workspace @aura/server run prisma:migrate",
    "prisma:generate": "npm --workspace @aura/server run prisma:generate"
  }
}
