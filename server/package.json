{
  "name": "@radix/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/routes/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke:local": "SMOKE_BASE_URL=http://127.0.0.1:8787 vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^9.1.0",
    "@google/genai": "^1.47.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.0.0",
    "dotenv": "^17.4.1",
    "fastify": "^5.3.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.1",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.59.1",
    "pptxgenjs": "^3.12.0",
    "sharp": "^0.34.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "prisma": "^6.7.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
