generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("member")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments       PostComment[]
  auditLogs      AuditLog[]
  agentSessions  AgentSession[]
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  replacedBy  String?
  userAgent   String?
  ip          String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  primaryColor    String?
  timezone        String?
  industry        String?
  website         String?
  instagramHandle String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brief           ClientBrief?
  assets          Asset[]
  knowledgeItems  KnowledgeItem[]
  calendarMonths  CalendarMonth[]
  reviewLinks     ReviewLink[]
  agentSessions   AgentSession[]
  contentPieces   ContentPiece[]
  apiKeys         ApiKey[]
}

// External-integration API keys. Plaintext key (sk-radix-{32}) is only ever
// returned at creation time; only the bcrypt hash + 12-char prefix live in
// Postgres. Scope is per-Client — agencies issue separate keys per workspace
// instead of one master key. Revocation is soft (revokedAt) so audit trails
// survive. lastUsedAt is updated async on every authenticated /v2 request.
model ApiKey {
  id          String    @id @default(cuid())
  clientId    String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([keyHash])
}

// Production-tracking unit — separate from CalendarPost (which is the marketing
// calendar output).  A ContentPiece is a produced deliverable: a reel, image,
// story, article that's assigned to a station + assignee with a deadline + review
// status.  Pre-2026-04-24 this lived entirely in browser localStorage
// (radix_content_pieces) — rating P1, now backend-persisted.
model ContentPiece {
  id             String   @id @default(cuid())
  clientId       String
  title          String
  type           String   // Image | Video | Reel | Story | Carousel | Article
  station        String   // Lebanon | Abu Dhabi | Investigations | Clips
  topicId        String   @default("")
  status         String   @default("Draft") // Draft | In Design | In Review | Approved | Published
  assignee       String   @default("")
  deadline       String   @default("") // ISO date string, empty if unset
  visualRefUrl   String   @default("")
  visualRefImage String   @default("")
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, status])
  @@index([clientId, station])
}

model ClientBrief {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  objective           String
  audience            String
  tone                String
  brandDo             String
  brandDont           String
  products            Json
  pillars             Json
  campaignMoments     Json
  mandatoryInclusions String?
  complianceNotes     String?
  channels            Json
  cadence             String?
  references          String?
  approvers           Json
  seasonalNotes       String?
  competitors         String?
  successDefinition   String?
  pastLearnings       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model KnowledgeItem {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  type        String
  fileUrl     String?
  textContent String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]

  @@index([clientId])
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  knowledgeItemId String
  chunkText       String
  // embedding    Unsupported("vector")?  // Requires pgvector — enabled in Commit 8
  metadata        Json?

  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model Asset {
  id             String   @id @default(cuid())
  clientId       String
  name           String
  fileUrl        String
  thumbUrl       String?
  mimeType       String
  width          Int?
  height         Int?
  analysis       Json?
  tags           Json?
  safeForClient  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  linkedPosts    CalendarPostAsset[]

  @@index([clientId])
}

model CalendarMonth {
  id          String    @id @default(cuid())
  clientId    String
  month       String
  status      String    @default("draft")
  strategy    Json?
  isTest      Boolean   @default(false)
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts       CalendarPost[]

  @@unique([clientId, month])
  @@index([clientId, isArchived])
}

model CalendarPost {
  id              String   @id @default(cuid())
  calendarMonthId String
  date            String
  title           String
  pillar          String
  platform        String
  format          String
  hook            String?
  keyMessage      String?
  caption         String
  cta             String?
  hashtags        Json?
  visualDirection String?
  referenceQuery  String?
  rationale       String?
  timing          String?
  status          String   @default("draft")
  version         Int      @default(1)
  metadata        Json?    // agent annotations: compliance findings, tool provenance, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  calendarMonth   CalendarMonth         @relation(fields: [calendarMonthId], references: [id], onDelete: Cascade)
  comments        PostComment[]
  versions        PostVersion[]
  assets          CalendarPostAsset[]
  visualRefs      PostVisualReference[]

  @@unique([calendarMonthId, date])
  @@index([calendarMonthId])
}

model PostVisualReference {
  id            String   @id @default(cuid())
  postId        String
  thumbnailUrl  String
  sourceUrl     String
  sourceDomain  String
  sourceType    String   @default("web")
  title         String?
  description   String?
  pinId         String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  post          CalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([sourceDomain])
}

model CalendarPostAsset {
  postId  String
  assetId String

  post    CalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset   Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([postId, assetId])
}

model PostVersion {
  id        String   @id @default(cuid())
  postId    String
  snapshot  Json
  createdAt DateTime @default(now())
  createdBy String?

  post      CalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostComment {
  id         String   @id @default(cuid())
  postId     String
  authorId   String?
  authorName String
  source     String
  comment    String
  status     String?
  createdAt  DateTime @default(now())

  post       CalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User?        @relation(fields: [authorId], references: [id])

  @@index([postId])
  @@index([authorId])
}

model ReviewLink {
  id              String    @id @default(cuid())
  clientId        String
  calendarMonthId String
  token           String    @unique
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ExportJob {
  id              String   @id @default(cuid())
  clientId        String
  calendarMonthId String
  type            String
  status          String   @default("queued")
  fileUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  clientId   String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
}

// ─── Agent platform (Phase 1: real-time spine) ────────────────────────
model AgentSession {
  id        String   @id @default(cuid())
  uid       String   @unique
  userId    String?   // per-user ownership; nullable for legacy rows pre-migration
  clientId  String?
  title     String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages  AgentMessage[]
  events    AgentEvent[]

  @@index([userId])
  @@index([clientId])
  @@index([updatedAt])
}

model AgentMessage {
  id         String   @id @default(cuid())
  sessionId  String
  role       String
  content    String
  toolCallId String?
  createdAt  DateTime @default(now())

  session    AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AgentEvent {
  id        String   @id @default(cuid())
  sessionId String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
