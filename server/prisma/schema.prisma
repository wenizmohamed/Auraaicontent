generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenancy primitives ─────────────────────────────────────────
// An Organization is a billing + workspace boundary. Every tenant-scoped
// row carries `orgId` so a single missed scope cannot leak data across
// agencies. Plan/status/stripeCustomerId hang here so billing webhooks
// have one obvious target.
model Organization {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  plan             String    @default("trial") // trial | free | starter | studio | agency
  status           String    @default("active") // active | past_due | canceled
  stripeCustomerId String?
  trialEndsAt      DateTime?
  // Monthly AI spend cap in USD. 0 = no enforcement (unlimited). When > 0,
  // the ai-router refuses calls once month-to-date UsageEvent.costUsd >= this
  // value. UI surfaces a soft warning at 80% via /api/dashboard/ai-stats.
  monthlyAiBudgetUsd Decimal  @db.Decimal(10, 2) @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships     OrgMembership[]
  invitations     Invitation[]
  clients         Client[]
  apiKeys         ApiKey[]
  contentPieces   ContentPiece[]
  briefs          ClientBrief[]
  knowledgeItems  KnowledgeItem[]
  knowledgeChunks KnowledgeChunk[]
  assets          Asset[]
  brandKits       BrandKit[]
  productRefs     ProductReference[]
  calendarMonths  CalendarMonth[]
  calendarPosts   CalendarPost[]
  postVisualRefs  PostVisualReference[]
  postAssetLinks  CalendarPostAsset[]
  postVersions    PostVersion[]
  postComments    PostComment[]
  reviewLinks     ReviewLink[]
  exportJobs      ExportJob[]
  auditLogs       AuditLog[]
  agentSessions   AgentSession[]
  agentMessages   AgentMessage[]
  agentEvents     AgentEvent[]
  usageEvents     UsageEvent[]
  platformConnections PlatformConnection[]
  generations     Generation[]
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model OrgMembership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole  @default(EDITOR)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        OrgRole   @default(EDITOR)
  token       String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

// ─── Users & auth ─────────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("member") // legacy field — use OrgMembership.role
  currentOrgId  String?  // pointer to user's active org (drives JWT-issuing)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments       PostComment[]
  auditLogs      AuditLog[]
  agentSessions  AgentSession[]
  refreshTokens  RefreshToken[]
  memberships    OrgMembership[]
  usageEvents    UsageEvent[]
  generations    Generation[]
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  replacedBy  String?
  userAgent   String?
  ip          String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Tenant-scoped business models ────────────────────────────────────
model Client {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  slug            String
  logoUrl         String?
  primaryColor    String?
  timezone        String?
  industry        String?
  website         String?
  instagramHandle String?
  status          String   @default("active")
  // GCC wedge — Phase 3
  locale          String   @default("en") // en | ar
  dialect         String?  // MSA | KHALEEJI | EGYPTIAN | LEVANTINE
  whatsappNumber  String?  // E.164 format for WhatsApp Business export
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brief           ClientBrief?
  brandKit        BrandKit?
  assets          Asset[]
  productRefs     ProductReference[]
  knowledgeItems  KnowledgeItem[]
  calendarMonths  CalendarMonth[]
  reviewLinks     ReviewLink[]
  agentSessions   AgentSession[]
  contentPieces   ContentPiece[]
  apiKeys         ApiKey[]
  platformConnections PlatformConnection[]
  generations     Generation[]

  @@unique([orgId, slug])
  @@index([orgId])
}

// External-integration API keys. Plaintext key (sk-radix-{32}) is only ever
// returned at creation time; only the bcrypt hash + 12-char prefix live in
// Postgres. Scope is per-Client — agencies issue separate keys per workspace
// instead of one master key. Revocation is soft (revokedAt) so audit trails
// survive. lastUsedAt is updated async on every authenticated /v2 request.
model ApiKey {
  id          String    @id @default(cuid())
  orgId       String
  clientId    String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([clientId])
  @@index([keyHash])
}

// Production-tracking unit — separate from CalendarPost (which is the marketing
// calendar output).  A ContentPiece is a produced deliverable: a reel, image,
// story, article that's assigned to a station + assignee with a deadline + review
// status.  Pre-2026-04-24 this lived entirely in browser localStorage
// (radix_content_pieces) — rating P1, now backend-persisted.
model ContentPiece {
  id             String   @id @default(cuid())
  orgId          String
  clientId       String
  title          String
  type           String   // Image | Video | Reel | Story | Carousel | Article
  station        String   // Lebanon | Abu Dhabi | Investigations | Clips
  topicId        String   @default("")
  status         String   @default("Draft") // Draft | In Design | In Review | Approved | Published
  assignee       String   @default("")
  deadline       String   @default("") // ISO date string, empty if unset
  visualRefUrl   String   @default("")
  visualRefImage String   @default("")
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([clientId])
  @@index([clientId, status])
  @@index([clientId, station])
}

model ClientBrief {
  id                  String   @id @default(cuid())
  orgId               String
  clientId            String   @unique
  objective           String
  audience            String
  tone                String
  brandDo             String
  brandDont           String
  products            Json
  pillars             Json
  campaignMoments     Json
  mandatoryInclusions String?
  complianceNotes     String?
  channels            Json
  cadence             String?
  references          String?
  approvers           Json
  seasonalNotes       String?
  competitors         String?
  successDefinition   String?
  pastLearnings       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model KnowledgeItem {
  id          String   @id @default(cuid())
  orgId       String
  clientId    String
  title       String
  type        String
  fileUrl     String?
  textContent String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]

  @@index([orgId])
  @@index([clientId])
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  orgId           String
  knowledgeItemId String
  chunkText       String
  // embedding    Unsupported("vector")?  // Requires pgvector — enabled in Commit 8
  metadata        Json?

  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([knowledgeItemId])
}

model Asset {
  id             String   @id @default(cuid())
  orgId          String
  clientId       String
  name           String
  fileUrl        String
  thumbUrl       String?
  mimeType       String
  width          Int?
  height         Int?
  analysis       Json?
  tags           Json?
  safeForClient  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org            Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  linkedPosts    CalendarPostAsset[]

  @@index([orgId])
  @@index([clientId])
  @@index([mimeType, createdAt])
}

// Product reference gallery — workshop 2026-05-06 #4 (Haneen). Per-client
// catalog of products with multiple angle images so the user can drag-drop
// a product into any generation prompt and the AI will reuse the angles for
// visual consistency (Magnetic-style flow). Each ProductReference has
// many AngleImage children stored as URL pointers (we already have a
// storage service for asset uploads — reuse those URLs here rather than
// duplicating bytes into Json columns that bloat PG row size).
model ProductReference {
  id          String   @id @default(cuid())
  orgId       String
  clientId    String
  name        String
  description String?
  angles      Json     // [{ url, thumbUrl, mimeType, label?, primary? }]
  tags        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([clientId])
  @@index([clientId, createdAt])
}

model CalendarMonth {
  id          String    @id @default(cuid())
  orgId       String
  clientId    String
  month       String
  status      String    @default("draft")
  strategy    Json?
  isTest      Boolean   @default(false)
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts       CalendarPost[]

  @@unique([clientId, month])
  @@index([orgId])
  @@index([clientId, isArchived])
}

model CalendarPost {
  id              String   @id @default(cuid())
  orgId           String
  calendarMonthId String
  date            String
  title           String
  pillar          String
  platform        String
  format          String
  hook            String?
  keyMessage      String?
  caption         String
  cta             String?
  hashtags        Json?
  visualDirection String?
  referenceQuery  String?
  rationale       String?
  timing          String?
  status          String   @default("draft") // draft | approved | scheduled | published | failed
  version         Int      @default(1)
  metadata        Json?    // agent annotations: compliance findings, tool provenance, etc.
  // Per-platform publish state, e.g. { meta_ig: { status: "published", externalId, url, publishedAt }, tiktok: {...} }
  platformPublishStatus Json?
  // F2 Post scheduler (Wave 1.B) — set by user when staging an auto-publish.
  // scheduler.worker.ts polls (status='scheduled' AND scheduledAt <= now+60s)
  // and calls dispatchPublish(post, conn) for each match.
  scheduledAt          DateTime?
  platformConnectionId String?
  scheduleError        String?   // last error from a failed scheduler run
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  calendarMonth      CalendarMonth       @relation(fields: [calendarMonthId], references: [id], onDelete: Cascade)
  platformConnection PlatformConnection? @relation(fields: [platformConnectionId], references: [id], onDelete: SetNull)
  comments        PostComment[]
  versions        PostVersion[]
  assets          CalendarPostAsset[]
  visualRefs      PostVisualReference[]

  @@unique([calendarMonthId, date])
  @@index([orgId])
  @@index([calendarMonthId])
  @@index([createdAt])
  @@index([status])
  @@index([status, scheduledAt])
  @@index([platformConnectionId])
}

model PostVisualReference {
  id            String   @id @default(cuid())
  orgId         String
  postId        String
  thumbnailUrl  String
  sourceUrl     String
  sourceDomain  String
  sourceType    String   @default("web")
  title         String?
  description   String?
  pinId         String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  post          CalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([postId])
  @@index([sourceDomain])
}

model CalendarPostAsset {
  orgId   String
  postId  String
  assetId String

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  post    CalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset   Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([postId, assetId])
  @@index([orgId])
}

model PostVersion {
  id        String   @id @default(cuid())
  orgId     String
  postId    String
  snapshot  Json
  createdAt DateTime @default(now())
  createdBy String?

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  post      CalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model PostComment {
  id         String   @id @default(cuid())
  orgId      String
  postId     String
  authorId   String?
  authorName String
  source     String
  comment    String
  status     String?
  createdAt  DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  post       CalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User?        @relation(fields: [authorId], references: [id])

  @@index([orgId])
  @@index([postId])
  @@index([authorId])
}

model ReviewLink {
  id              String    @id @default(cuid())
  orgId           String
  clientId        String
  calendarMonthId String
  token           String    @unique
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([clientId])
}

model ExportJob {
  id              String   @id @default(cuid())
  orgId           String
  clientId        String
  calendarMonthId String
  type            String   // pptx | pdf | whatsapp
  status          String   @default("queued")
  fileUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([clientId])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String?
  clientId   String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
}

// ─── Agent platform (Phase 1: real-time spine) ────────────────────────
model AgentSession {
  id        String   @id @default(cuid())
  orgId     String
  uid       String   @unique
  userId    String?  // per-user ownership; nullable for legacy rows pre-migration
  clientId  String?
  title     String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages  AgentMessage[]
  events    AgentEvent[]

  @@index([orgId])
  @@index([userId])
  @@index([clientId])
  @@index([updatedAt])
}

model AgentMessage {
  id         String   @id @default(cuid())
  orgId      String
  sessionId  String
  role       String
  content    String
  toolCallId String?
  createdAt  DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session    AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([sessionId])
}

model AgentEvent {
  id        String   @id @default(cuid())
  orgId     String
  sessionId String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([sessionId, createdAt])
}

// ─── Billing & metering (Phase 2) ─────────────────────────────────────
// Every AI provider call writes one UsageEvent. Cost in USD is computed
// from token counts at write time so price-table changes don't retroactively
// rewrite history. enforceQuota() reads SUM(units) WHERE orgId=? AND kind=?
// AND createdAt > start_of_billing_period.
model UsageEvent {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  kind      String   // ai.text | ai.image | ai.video | ai.embedding | export | seat
  units     Int      @default(1) // tokens for ai.*, count for others
  costUsd   Decimal  @db.Decimal(10, 6) @default(0)
  ref       String?  // jobId, postId, exportId, etc.
  metadata  Json?
  createdAt DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, kind, createdAt])
}

// ─────────────────────────────────────────────────────────────────────
// PlatformConnection — OAuth-based connector to a third-party platform
// (Meta IG Business, TikTok Business, LinkedIn). Tokens are encrypted
// at rest via lib/secrets.ts (AES-256-GCM with RADIX_INTEGRATION_KEY).
// Scoped to (orgId, clientId) — each Radix client (brand) connects its
// own platform accounts independently.
// ─────────────────────────────────────────────────────────────────────
model PlatformConnection {
  id                  String    @id @default(cuid())
  orgId               String
  clientId            String
  platform            String    // 'meta_ig' | 'tiktok' | 'linkedin'
  externalAccountId   String    // platform's stable account id (ig_user_id, tt_open_id, urn:li:person:...)
  externalAccountName String?   // display name shown in connector card
  accessTokenEnc      String    // AES-256-GCM ciphertext via lib/secrets.ts
  refreshTokenEnc     String?   // null when platform doesn't issue refresh (Meta long-lived rolls in place)
  scopes              String[]
  expiresAt           DateTime?
  status              String    @default("connected") // connected | needs_reauth | revoked | error
  lastError           String?
  metadata            Json?     // platform-specific: pageAccessToken, audited flag, avatarUrl, etc.
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduledPosts CalendarPost[]

  @@unique([clientId, platform, externalAccountId])
  @@index([orgId])
  @@index([clientId, platform])
  @@index([status, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────
// Generation — universal AI generation history. Every image/video/text/
// research/analysis call should write one row via lib/history.service.ts
// recordGeneration(), best-effort. Lets users recover any prompt + output
// even if they didn't explicitly save the result as an Asset/Post.
// ─────────────────────────────────────────────────────────────────────
model Generation {
  id           String   @id @default(cuid())
  orgId        String
  userId       String?  // nullable for system/worker calls; set when call originated from a user request
  clientId     String?  // nullable for ad-hoc generations not scoped to a brand
  type         String   // 'image' | 'video' | 'text' | 'research' | 'brand_synthesis' | 'analyze' | 'design'
  surface      String?  // 'creative_tools' | 'studio' | 'research' | 'design_textures' | 'video_analysis' | 'agent' — origin UI
  prompt       String   // the user prompt or task summary
  outputUrl    String?  // image/video URL if applicable
  outputText   String?  // text/JSON result if applicable (truncated to 50k chars at write time)
  thumbnailUrl String?  // small preview for grid view
  provider     String?  // 'gemini' | 'xai' | 'moonshot' | etc.
  model        String?  // exact model id used
  costUsd      Decimal? @db.Decimal(10, 6)
  latencyMs    Int?
  status       String   @default("succeeded") // succeeded | failed
  error        String?  // last error message when status='failed'
  metadata     Json?    // surface-specific extras (aspectRatio, duration, sourceImageUrl, etc.)
  createdAt    DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  client Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, type, createdAt])
  @@index([clientId, createdAt])
  @@index([userId, createdAt])
}

// ─── BrandKit v2 (F3) ──────────────────────────────────────────────
// Standalone 1:1 with Client.  Avoids bloating Client schema, gives us
// native versioning via BrandKitVersion (full prior-state snapshot for
// rollback).  primaryColor + logoUrl on Client are PRESERVED (legacy
// callers still read them); BrandKit mirrors primaryColor for compute
// simplicity at injection time.  Failure mode: enricher is a no-op when
// no BrandKit row exists for the client.
model BrandKit {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  orgId              String
  version            Int      @default(1)
  // Visual identity
  primaryColor       String?  // already on Client — also mirrored here for compute simplicity
  secondaryColor     String?
  accentColor        String?
  // Typography
  fontPrimary        String?  // CSS font-family or Google Fonts name
  fontSecondary      String?
  // Voice (multi-sample per ai-brand-kit principle "voice training requires volume")
  voiceSamples       Json[]   // [{ context: 'instagram'|'linkedin'|'tiktok'|'x'|'email'|'general', sample: '...' }]
  voiceDoNot         Json?    // { rules: ['Never use gradients', 'Avoid emoji in headlines', ...] }
  voicePerPlatform   Json?    // { instagram: 'casual + ALL CAPS optional', linkedin: 'professional', ... }
  // Visual anchors (per ai-brand-kit principle "10-20 brand anchor images")
  sampleImages       Json[]   // [{ url, label, primary?, mimeType }] — CDN URLs, NOT base64 (DB bloat)
  // Governance
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  changelogEntries   BrandKitVersion[]
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@index([orgId])
  @@index([clientId])
}

model BrandKitVersion {
  id          String   @id @default(cuid())
  brandKitId  String
  version     Int
  changedBy   String?  // userId
  changedAt   DateTime @default(now())
  snapshot    Json     // full prior state for rollback
  brandKit    BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  @@index([brandKitId, version])
}
