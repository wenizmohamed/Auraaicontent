DATABASE_URL=postgresql://postgres:postgres@localhost:5432/radix_planner
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
PORT=8080

# xAI (Grok) — primary for text/image/video
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4-fast-reasoning
XAI_IMAGE_MODEL=grok-imagine-image
XAI_VIDEO_MODEL=grok-imagine-video
XAI_TIMEOUT_MS=90000

# Gemini — fallback for text/image/video, primary for analysis/embeddings
GEMINI_API_KEY=your-gemini-key-here
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_IMAGE_FAST_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_TIMEOUT_MS=90000

# Routing
AI_TEXT_PRIMARY=xai
AI_IMAGE_PRIMARY=xai
AI_VIDEO_PRIMARY=xai
AI_ANALYSIS_PRIMARY=gemini
AI_ENABLE_FALLBACK=true

PREVIEW_URL=http://localhost:5174
