# ─── Core infra ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/radix_planner
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
PORT=8080

# ─── Gemini (PRIMARY for text/image/video/analysis/embeddings) ───────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
GEMINI_CHAT_MODEL=gemini-3.1-pro-preview
GEMINI_ANALYSIS_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_TEXT_MODEL=gemini-3-flash-preview
GEMINI_LITE_MODEL=gemini-3.1-flash-lite-preview
# Image models — Nano Banana family (Gemini's native image gen).
# Per https://ai.google.dev/gemini-api/docs/image-generation:
#   - gemini-3.1-flash-image-preview  =  Nano Banana 2  (fast, $0.0672/img)
#   - gemini-3-pro-image-preview      =  Nano Banana Pro (high-quality, $0.134/img)
#   - imagen-4.0-fast-generate-001    =  Imagen 4 Fast (legacy fallback path)
# NB2 access requires billing-enabled project. If your key 60s-times-out
# on NB2, use NB Pro as the primary fallback (works on free billing tier).
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_IMAGE_FAST_MODEL=gemini-3.1-flash-image-preview
GEMINI_IMAGE_ULTRA_MODEL=gemini-3-pro-image-preview
GEMINI_IMAGE_EDIT_MODEL=gemini-3.1-flash-image-preview
GEMINI_IMAGE_EDIT_TIMEOUT_MS=120000
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_VIDEO_FAST_MODEL=veo-3.1-fast-generate-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_TIMEOUT_MS=90000

# ─── xAI / Grok (FALLBACK for text/image/video) ──────────────────────
# Get a key at https://console.x.ai
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4-fast-reasoning
XAI_IMAGE_MODEL=grok-imagine-image
XAI_VIDEO_MODEL=grok-imagine-video
XAI_TIMEOUT_MS=90000

# ─── Moonshot / Kimi (TERTIARY long-context text fallback) ───────────
# Get a key at https://platform.moonshot.cn
MOONSHOT_API_KEY=sk-your-moonshot-key-here
MOONSHOT_MODEL=kimi-k2-thinking-preview

# ─── Provider routing per task ──────────────────────────────────────
# Primary picks the first provider; AI_ENABLE_FALLBACK=true auto-falls
# back to the other one (xai<->gemini). Defaults below match live prod
# as of 2026-04-29: text/image/analysis → Gemini 3.1 Pro; video → Grok
# (grok-imagine-video) because it's ~58% cheaper than Gemini Veo 3.1
# Fast and ranks #1 on Artificial Analysis text-to-video ELO.
AI_TEXT_PRIMARY=gemini
AI_IMAGE_PRIMARY=gemini
AI_VIDEO_PRIMARY=xai
AI_ANALYSIS_PRIMARY=gemini
AI_ENABLE_FALLBACK=true

# ─── Misc ─────────────────────────────────────────────────────────────
CORS_ORIGIN=
PREVIEW_URL=http://localhost:5174

# ─── Multi-tenancy guard ─────────────────────────────────────────────
# warn = log unscoped queries (dev/migration); throw = reject (prod)
RADIX_TENANT_GUARD=throw

# ─── Staff-only admin dashboard ──────────────────────────────────────
# Comma-separated emails that can hit /api/admin/*
STAFF_EMAILS=admin@example.com

# ─── Team-management gate ────────────────────────────────────────────
# Comma-separated emails that can manage org members & invitations.
# Empty = fall through to OWNER/ADMIN role check.
TEAM_ADMIN_EMAILS=

# ─── Auto-join domains (NEVER set in dev/staging/CI) ──────────────────
# Comma-separated DOMAIN:ORG_ID:ROLE entries. When a new user signs up
# with an @domain email, they're auto-added to ORG_ID with ROLE instead
# of getting a fresh personal org. MUST be empty unless this instance
# is explicitly tied to an existing production tenant — otherwise dev
# boots silently enrol real users into a wrong org.
# Example: AUTO_ORG_DOMAINS=mycorp.com:org_mycorp:EDITOR
AUTO_ORG_DOMAINS=

# ─── Stripe (Phase 2 billing) ────────────────────────────────────────
# Leave blank to disable billing routes (return 503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_AGENCY=

# ─── Email (Resend, optional) ────────────────────────────────────────
# Without RESEND_API_KEY, invitation emails are logged to pm2 instead.
RESEND_API_KEY=
EMAIL_FROM=Radix <invites@yourdomain.com>
PUBLIC_APP_URL=https://your-app.example.com

# ─── Sentry (optional) ───────────────────────────────────────────────
SENTRY_DSN=

# ─── OAuth platform connectors ─────────────────────────────────────
# AES-256-GCM key for encrypting stored OAuth tokens at rest.
# Generate with: openssl rand -base64 32
RADIX_INTEGRATION_KEY=

# Public app base URL — used to construct OAuth redirect URIs.
RADIX_APP_BASE_URL=https://radix.synapseai-labs.com

# Meta / Instagram Business (Facebook Login for Business + Instagram Graph API)
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=

# TikTok Business (Login Kit v2 / Direct Post API)
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=

# LinkedIn (w_member_social — personal share v1; Pages support is v2)
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
